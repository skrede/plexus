# The per-block checks of the include-order gate. A block entry is "<line>|<kind>|<path>": kind Q for a quoted
# include, A for an angle include and B for a blank line. A directory is spelled "." for the top level, since CMake
# cannot tell an empty list from a list holding one empty element.

set(_inc_std_headers
    algorithm any array atomic barrier bit bitset charconv chrono codecvt compare complex concepts condition_variable
    coroutine deque exception execution expected filesystem format forward_list fstream functional future generator
    initializer_list iomanip ios iosfwd iostream istream iterator latch limits list locale map mdspan memory
    memory_resource mutex new numbers numeric optional ostream print queue random ranges ratio regex scoped_allocator
    semaphore set shared_mutex source_location span spanstream sstream stack stacktrace stdexcept stdfloat stop_token
    streambuf string string_view strstream syncstream system_error thread tuple type_traits typeindex typeinfo
    unordered_map unordered_set utility valarray variant vector version cassert cctype cerrno cfenv cfloat cinttypes
    climits clocale cmath csetjmp csignal cstdarg cstddef cstdint cstdio cstdlib cstring ctime cuchar cwchar cwctype)
foreach(_header IN LISTS _inc_std_headers)
    set(_inc_std_${_header} 1)
endforeach()
set(_inc_section_names project third-party standard)

function(_inc_report line kind detail)
    message(STATUS "include order gate: ${_inc_rel}:${line}: ${kind}: ${detail}")
    set_property(GLOBAL APPEND PROPERTY INCLUDE_GATE_HITS "${_inc_rel}")
endfunction()

# 0 project, 1 third-party, 2 standard: a quoted include is project only when it names a scanned file.
function(_inc_section quote path out_var)
    set(_section 1)
    if(quote STREQUAL "Q" AND DEFINED _inc_proj_${path})
        set(_section 0)
    elseif(quote STREQUAL "A" AND DEFINED _inc_std_${path})
        set(_section 2)
    endif()
    set(${out_var} ${_section} PARENT_SCOPE)
endfunction()

function(_inc_groups entries out_var)
    set(_groups "")
    set(_group "")
    set(_blanks 0)
    foreach(_entry IN LISTS entries)
        if(_entry MATCHES "^([0-9]+)\\|B\\|$")
            math(EXPR _blanks "${_blanks} + 1")
            continue()
        endif()
        if(_blanks GREATER 0 AND NOT _group STREQUAL "")
            if(_blanks GREATER 1)
                string(REGEX MATCH "^[0-9]+" _line "${_entry}")
                _inc_report(${_line} blank "${_blanks} blank lines between two groups")
            endif()
            list(APPEND _groups "${_group}")
            set(_group "")
        endif()
        set(_blanks 0)
        string(APPEND _group ",${_entry}")
    endforeach()
    list(APPEND _groups "${_group}")
    set(${out_var} "${_groups}" PARENT_SCOPE)
endfunction()

macro(_inc_add_entry entry)
    string(REPLACE "|" ";" _f_parts "${entry}")
    list(GET _f_parts 0 _f_at)
    list(GET _f_parts 1 _f_quote)
    list(GET _f_parts 2 _f_path)
    _inc_section(${_f_quote} "${_f_path}" _f_sec)
    get_filename_component(_f_dir "${_f_path}" DIRECTORY)
    get_filename_component(_f_name "${_f_path}" NAME)
    if(_f_dir STREQUAL "")
        set(_f_dir .)
    endif()
    if(_f_line STREQUAL "")
        set(_f_line ${_f_at})
    endif()
    list(APPEND _f_sections ${_f_sec})
    list(APPEND _f_dirs "${_f_dir}")
    list(APPEND _f_keys "${_f_sec}:${_f_dir}")
    list(APPEND _f_names "${_f_name}")
endmacro()

# Sets _f_line, _f_section (the lowest present), _f_mixed, _f_dirs, _f_keys (section:directory) and _f_names.
macro(_inc_group_facts group)
    string(SUBSTRING "${group}" 1 -1 _f_entries)
    string(REPLACE "," ";" _f_entries "${_f_entries}")
    foreach(_f_var IN ITEMS _f_line _f_sections _f_dirs _f_keys _f_names)
        set(${_f_var} "")
    endforeach()
    foreach(_f_entry IN LISTS _f_entries)
        _inc_add_entry("${_f_entry}")
    endforeach()
    list(REMOVE_DUPLICATES _f_sections)
    list(REMOVE_DUPLICATES _f_dirs)
    list(REMOVE_DUPLICATES _f_keys)
    list(SORT _f_sections)
    list(GET _f_sections 0 _f_section)
    list(LENGTH _f_sections _f_mixed)
endmacro()

# Names sort by length, shortest first, then byte-wise; a length inversion outranks an alphabetical one.
function(_inc_check_order line names)
    set(_keyed "")
    set(_kind "")
    set(_prev "")
    foreach(_name IN LISTS names)
        string(LENGTH "${_name}" _len)
        string(LENGTH "${_prev}" _prev_len)
        if(NOT _prev STREQUAL "" AND _prev_len GREATER _len)
            set(_kind length)
        elseif(NOT _prev STREQUAL "" AND _prev_len EQUAL _len AND _prev STRGREATER _name AND _kind STREQUAL "")
            set(_kind alpha)
        endif()
        set(_prev "${_name}")
        math(EXPR _len "${_len} + 1000")
        list(APPEND _keyed "${_len}:${_name}")
    endforeach()
    if(NOT _kind STREQUAL "")
        list(SORT _keyed)
        list(TRANSFORM _keyed REPLACE "^[0-9]+:" "")
        list(JOIN _keyed " " _want)
        _inc_report(${line} ${_kind} "sort as ${_want}")
    endif()
endfunction()

function(_inc_check_sections line)
    list(GET _inc_section_names ${_f_section} _name)
    if(_f_mixed GREATER 1)
        _inc_report(${line} section "one group mixes sections")
    endif()
    if(_f_section LESS _last)
        list(GET _inc_section_names ${_last} _before)
        _inc_report(${line} section "a ${_name} group follows a ${_before} group")
    endif()
endfunction()

function(_inc_check_folders line)
    list(LENGTH _f_dirs _ndirs)
    if(NOT _f_section EQUAL 2 AND _ndirs GREATER 1)
        list(JOIN _f_dirs ", " _spanned)
        _inc_report(${line} folder "one group spans ${_spanned}")
    else()
        _inc_check_order(${line} "${_f_names}")
    endif()
    foreach(_key IN LISTS _f_keys)
        list(FIND _seen "${_key}" _at)
        if(NOT _at EQUAL -1)
            string(REGEX REPLACE "^[0-9]:" "" _dir "${_key}")
            if(_key MATCHES "^2:")
                set(_dir "the standard section")
            endif()
            _inc_report(${line} split "${_dir} is split across two groups")
            break()
        endif()
    endforeach()
endfunction()

# The own directory leads the project section: reported at the first project group when a later one holds it.
macro(_inc_track_own)
    if(_f_section EQUAL 0 AND _project EQUAL 0)
        set(_first_project ${_f_line})
    endif()
    if(_f_section EQUAL 0 AND NOT _own_found AND _f_dirs STREQUAL "${_inc_own}")
        set(_own_found TRUE)
        if(_project GREATER 0)
            _inc_report(${_first_project} own "own directory ${_inc_own} is not the first project group")
        endif()
    endif()
    if(_f_section EQUAL 0)
        math(EXPR _project "${_project} + 1")
    endif()
endmacro()

function(_inc_check_block)
    _inc_groups("${ARGN}" _groups)
    set(_last 0)
    set(_seen "")
    set(_project 0)
    set(_own_found FALSE)
    foreach(_group IN LISTS _groups)
        _inc_group_facts("${_group}")
        _inc_check_sections(${_f_line})
        _inc_check_folders(${_f_line})
        _inc_track_own()
        if(_f_section GREATER _last)
            set(_last ${_f_section})
        endif()
        list(APPEND _seen ${_f_keys})
    endforeach()
endfunction()
