# Counts a library function as it sits on screen, from its signature's first line to its closing brace, out of the
# line of its name and the body length clang-tidy reports. The count relies on the clang-format layout: a function's
# opening and closing braces sit on lines of their own, indented like the signature's first line.

# The source becomes a list of lines; the characters that would split or nest a CMake list are replaced first, so an
# element is always one line (a ';' becomes the byte 0x01).
function(function_size_gate_source_lines file out)
    string(MD5 _key "${file}")
    get_property(_cached GLOBAL PROPERTY function_size_gate_source_${_key} SET)
    if(NOT _cached)
        file(READ "${file}" _text)
        string(ASCII 1 _semicolon)
        string(REPLACE "\\" "/" _text "${_text}")
        string(REPLACE ";" "${_semicolon}" _text "${_text}")
        string(REPLACE "[" "<" _text "${_text}")
        string(REPLACE "]" ">" _text "${_text}")
        string(REPLACE "\n" ";" _text "${_text}")
        set_property(GLOBAL PROPERTY function_size_gate_source_${_key} "${_text}")
    endif()
    get_property(_text GLOBAL PROPERTY function_size_gate_source_${_key})
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

# Walks up from the name line while the line above continues the declaration (a template header, a return type, an
# attribute); comment lines are passed over, so a NOLINT between a template header and its name stays inside.
function(function_size_gate_signature_start lines name out)
    string(ASCII 1 _semicolon)
    set(_first ${name})
    set(_at ${name})
    while(_at GREATER 0)
        math(EXPR _at "${_at} - 1")
        list(GET ${lines} ${_at} _line)
        string(STRIP "${_line}" _line)
        string(REGEX REPLACE "[ \t]+//.*$" "" _code "${_line}")
        if(_line STREQUAL "" OR _line MATCHES "^#")
            break()
        elseif(_line MATCHES "^(//|/\\*|\\*)")
            continue()
        elseif(_line MATCHES "[{}:,(${_semicolon}]$" OR _code MATCHES "[{}:,(${_semicolon}]$")
            break()
        endif()
        set(_first ${_at})
    endwhile()
    set(${out} ${_first} PARENT_SCOPE)
endfunction()

# The body opens on the first line from the name on that holds a lone brace at the signature's indentation, which
# skips an initializer's or default argument's lambda; the close must sit body lines below it at the same indentation.
function(function_size_gate_body_close lines first name body out)
    set(${out} "" PARENT_SCOPE)
    list(LENGTH ${lines} _count)
    list(GET ${lines} ${first} _line)
    string(REGEX MATCH "^[ \t]*" _indent "${_line}")
    set(_open ${name})
    while(_open LESS _count)
        list(GET ${lines} ${_open} _line)
        if(_line MATCHES "^${_indent}{[ \t]*$")
            break()
        endif()
        math(EXPR _open "${_open} + 1")
    endwhile()
    math(EXPR _close "${_open} + ${body}")
    if(_close LESS _count)
        list(GET ${lines} ${_close} _line)
        if(_line MATCHES "^${_indent}}")
            set(${out} ${_close} PARENT_SCOPE)
        endif()
    endif()
endfunction()

function(function_size_gate_screen_lines file name_line body out)
    set(${out} "" PARENT_SCOPE)
    if(NOT EXISTS "${file}")
        return()
    endif()
    function_size_gate_source_lines("${file}" _source)
    math(EXPR _name "${name_line} - 1")
    function_size_gate_signature_start(_source ${_name} _first)
    function_size_gate_body_close(_source ${_first} ${_name} ${body} _close)
    if(NOT _close STREQUAL "")
        math(EXPR _screen "${_close} - ${_first} + 1")
        set(${out} ${_screen} PARENT_SCOPE)
    endif()
endfunction()

# A cognitive-complexity warning is an overage as it stands; a function-size warning is one when its screen count
# exceeds the ceiling or cannot be taken from the source. Reads the caller's _body_<key> lengths.
function(function_size_gate_judge warning out)
    set(${out} "" PARENT_SCOPE)
    if(NOT warning MATCHES "^((.*):([0-9]+):[0-9]+): warning: .*readability-function-size")
        set(${out} "${warning}" PARENT_SCOPE)
        return()
    endif()
    set(_file "${CMAKE_MATCH_2}")
    set(_name_line ${CMAKE_MATCH_3})
    string(MD5 _key "${CMAKE_MATCH_1}")
    set(_body 0)
    if(DEFINED _body_${_key})
        set(_body ${_body_${_key}})
    endif()
    function_size_gate_screen_lines("${_file}" ${_name_line} ${_body} _screen)
    if(_screen STREQUAL "")
        set(${out} "${warning} -- not measurable from the source" PARENT_SCOPE)
    elseif(_screen GREATER FUNC_GATE_CEILING)
        set(${out} "${warning} -- ${_screen} lines on screen" PARENT_SCOPE)
    endif()
endfunction()

function(function_size_gate_overages diagnostics out)
    set(_warnings "")
    foreach(_line IN LISTS ${diagnostics})
        if(_line MATCHES "^(.*): note: ([0-9]+) lines including")
            string(MD5 _key "${CMAKE_MATCH_1}")
            set(_body_${_key} ${CMAKE_MATCH_2})
        else()
            list(APPEND _warnings "${_line}")
        endif()
    endforeach()
    set(_overages "")
    foreach(_warning IN LISTS _warnings)
        function_size_gate_judge("${_warning}" _verdict)
        if(NOT _verdict STREQUAL "")
            list(APPEND _overages "${_verdict}")
        endif()
    endforeach()
    set(${out} "${_overages}" PARENT_SCOPE)
endfunction()
