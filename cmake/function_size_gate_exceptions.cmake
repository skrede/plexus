# EXCEPTIONS.md's function rows, `| `<name>` | <file> | <ceiling> | <justification> |` under its "## Function
# exceptions" heading, become two index-aligned lists, keys (<file>|<name>) and ceilings, since CMake has no map. A row
# sanctions the one function of its name in its file, the name as clang-tidy quotes it, up to its ceiling; the line
# takes no part, so a row never moves with its function. The rows are read as a source is, so a name is matched under
# the same bracket replacement.

function(function_size_gate_row_defect file ceiling key keys out)
    if(NOT file MATCHES "^[^ :]+\\.(h|hpp|cpp|cc)$")
        set(${out} "function row's file cell is not a source path" PARENT_SCOPE)
    elseif(NOT ceiling MATCHES "^[0-9]+$" OR NOT ceiling GREATER FUNC_GATE_CEILING)
        set(${out} "function row has no valid ceiling above ${FUNC_GATE_CEILING}" PARENT_SCOPE)
    elseif(key IN_LIST keys)
        set(${out} "duplicate function row" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

# A defective row registers nothing, so the function it names reads as an overage besides the defect.
function(function_size_gate_read_rows md)
    function_size_gate_source_lines("${md}" _lines)
    set(_section FALSE)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^## ")
            string(STRIP "${_line}" _heading)
            string(COMPARE EQUAL "${_heading}" "## Function exceptions" _section)
        elseif(_section AND _line MATCHES "^\\| *`([^`]+)` *\\|([^|]*)\\|([^|]*)\\|")
            set(_name "${CMAKE_MATCH_1}")
            string(STRIP "${CMAKE_MATCH_2}" _file)
            string(STRIP "${CMAKE_MATCH_3}" _ceiling)
            function_size_gate_row_defect("${_file}" "${_ceiling}" "${_file}|${_name}" "${_row_keys}" _defect)
            if(_defect STREQUAL "")
                list(APPEND _row_keys "${_file}|${_name}")
                list(APPEND _row_ceilings ${_ceiling})
            else()
                list(APPEND _row_defects "${_file} `${_name}`: ${_defect}")
            endif()
        endif()
    endforeach()
    set(FUNC_GATE_ROW_KEYS "${_row_keys}" PARENT_SCOPE)
    set(FUNC_GATE_ROW_CEILINGS "${_row_ceilings}" PARENT_SCOPE)
    set(FUNC_GATE_ROW_DEFECTS "${_row_defects}" PARENT_SCOPE)
endfunction()

# A measured function without a row is an overage at once when over the ceiling. One with a row is tallied for that
# row instead, since only the whole run shows whether its row covers exactly one function of its name.
function(function_size_gate_sanction file name screen warning out)
    set(${out} "" PARENT_SCOPE)
    set(_row -1)
    if(FUNC_GATE_ROW_KEYS)
        file(RELATIVE_PATH _rel "${FUNC_GATE_ROOT}" "${file}")
        string(REPLACE "[" "<" _name "${name}")
        string(REPLACE "]" ">" _name "${_name}")
        list(FIND FUNC_GATE_ROW_KEYS "${_rel}|${_name}" _row)
    endif()
    if(_row EQUAL -1)
        if(screen GREATER FUNC_GATE_CEILING)
            set(${out} "${warning} -- ${screen} lines on screen" PARENT_SCOPE)
        endif()
        return()
    endif()
    set_property(GLOBAL PROPERTY function_size_gate_row_measured_${_row} TRUE)
    if(screen GREATER FUNC_GATE_CEILING)
        set_property(GLOBAL APPEND PROPERTY function_size_gate_row_hits_${_row} "${warning} -- ${screen} lines on screen")
        set_property(GLOBAL APPEND PROPERTY function_size_gate_row_screens_${_row} ${screen})
    endif()
endfunction()

function(function_size_gate_row_verdict row key ceiling out)
    string(REGEX REPLACE "^([^|]*)\\|(.*)$" "\\1 `\\2`" _label "${key}")
    get_property(_hits GLOBAL PROPERTY function_size_gate_row_hits_${row})
    get_property(_screen GLOBAL PROPERTY function_size_gate_row_screens_${row})
    get_property(_measured GLOBAL PROPERTY function_size_gate_row_measured_${row})
    list(LENGTH _hits _count)
    set(${out} "" PARENT_SCOPE)
    if(_count GREATER 1)
        set(${out} "${_label}: ${_count} functions of this name over the ceiling, and one row sanctions one" PARENT_SCOPE)
    elseif(_count EQUAL 1 AND _screen GREATER ceiling)
        set(${out} "${_label}: ${_screen} lines on screen over its registered ceiling ${ceiling}" PARENT_SCOPE)
    elseif(_count EQUAL 0 AND _measured)
        set(${out} "stale function exception: ${_label} (measured at ${FUNC_GATE_CEILING} or fewer lines on screen)" PARENT_SCOPE)
    elseif(_count EQUAL 0)
        set(${out} "stale function exception: ${_label} (not measured)" PARENT_SCOPE)
    endif()
endfunction()

# A row two functions over the ceiling share covers neither, so both join the overages.
function(function_size_gate_row_verdicts overages out)
    set(_row_overages "${${overages}}")
    set(_row_findings "${FUNC_GATE_ROW_DEFECTS}")
    set(_row 0)
    foreach(_key _ceiling IN ZIP_LISTS FUNC_GATE_ROW_KEYS FUNC_GATE_ROW_CEILINGS)
        function_size_gate_row_verdict(${_row} "${_key}" ${_ceiling} _verdict)
        if(NOT _verdict STREQUAL "")
            list(APPEND _row_findings "${_verdict}")
        endif()
        if(_verdict MATCHES "functions of this name over the ceiling")
            get_property(_hits GLOBAL PROPERTY function_size_gate_row_hits_${_row})
            list(APPEND _row_overages ${_hits})
        endif()
        math(EXPR _row "${_row} + 1")
    endforeach()
    set(${overages} "${_row_overages}" PARENT_SCOPE)
    set(${out} "${_row_findings}" PARENT_SCOPE)
endfunction()
