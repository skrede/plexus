@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/plexusTargets.cmake")

# The exported plexus::plexus_asio_dep links whichever asio leaf the build host resolved, so an installed consumer
# recreates that leaf here, in cmake/plexus-deps.cmake's order. A macro, not a function, so the imported targets land
# in the caller's scope.
macro(_plexus_resolve_asio_leaf)
    if(NOT TARGET asio::asio AND NOT TARGET PkgConfig::plexus_asio_pc)
        find_package(asio CONFIG QUIET)
        if(NOT (asio_FOUND AND TARGET asio::asio))
            find_package(PkgConfig QUIET)
            if(PkgConfig_FOUND)
                pkg_check_modules(plexus_asio_pc QUIET IMPORTED_TARGET asio)
            endif()
        endif()
    endif()
endmacro()

# crypto's targets file references plexus::asio and plexus::plexus_asio_dep, so the asio component loads ahead of it.
macro(_plexus_load_component_deps comp)
    if("${comp}" STREQUAL "asio")
        _plexus_resolve_asio_leaf()
    elseif("${comp}" STREQUAL "crypto")
        _plexus_resolve_asio_leaf()
        find_dependency(OpenSSL)
        _plexus_load_component(asio)
    elseif("${comp}" STREQUAL "asio-shm")
        # On Linux the shm-include headers call io_uring_* directly and the exported
        # targets file references PkgConfig::LIBURING, so an installed consumer
        # recreates that imported target here; other hosts carry no liburing.
        _plexus_resolve_asio_leaf()
        _plexus_load_component(asio)
        _plexus_load_component(native)
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            find_dependency(PkgConfig)
            pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing)
        endif()
    endif()
endmacro()

# A component without an installed targets file reports FOUND FALSE without erroring; check_required_components makes
# a REQUIRED miss fatal.
macro(_plexus_load_component comp)
    if(NOT plexus_${comp}_FOUND)
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/plexus-${comp}-targets.cmake")
            _plexus_load_component_deps(${comp})
            include("${CMAKE_CURRENT_LIST_DIR}/plexus-${comp}-targets.cmake")
            set(plexus_${comp}_FOUND TRUE)
        else()
            set(plexus_${comp}_FOUND FALSE)
        endif()
    endif()
endmacro()

foreach(comp ${plexus_FIND_COMPONENTS})
    _plexus_load_component(${comp})
endforeach()

check_required_components(plexus)
